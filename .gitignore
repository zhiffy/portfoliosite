# dependencies & build output
node_modules/
dist/
.vite/
.codex-pydeps/

# heavy unreferenced video frame sources (kept out of the site too, see .vercelignore)
assets/videos/everything-yet-nothing-frames/
assets/videos/everything-yet-nothing-scrub/

# raw 4K video masters — kept locally as backup, optimized web versions are committed
assets/_video-masters/

# editor / sync temp + backup files (these caused the truncation issues)
*.tmp
*.tmp.*
*\ v1.html
.DS_Store
Thumbs.db
*.log
ds-preview/

# QA artifacts — not site content (already-tracked files need `git rm -r --cached screenshots qa`)
screenshots/
qa/

# local secrets
.env
.env.local
.env.*.local
!.env.example
ga-service-account*.json
ga-oauth*.json
tools/ga-oauth*.json
